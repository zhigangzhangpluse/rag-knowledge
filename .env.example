# ----------------------------------------------------------------------
# 这是配置模板，可以复制为 .env 后填写本机参数；真实密钥不要提交到 Git。
# 向量模型负责检索编码，LLM 负责组织答案，两个模型名称不能互换。
# 示例：调整 CHUNK_SIZE 后需要重新处理相应文档，旧分块不会自动改变。
# 面试问：改配置为什么不总是立即生效？答：配置通常启动时读取，已生成的数据也要按新策略重建。
# ----------------------------------------------------------------------
DEEPSEEK_API_KEY=replace_with_your_key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1200
LLM_TIMEOUT=90
APP_MODE=production
DATABASE_URL=sqlite:///./data/app.db
MILVUS_URI=http://127.0.0.1:19530
MILVUS_COLLECTION=rag_chunks
REDIS_URL=redis://127.0.0.1:6379/0
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
MODEL_DEVICE=cpu
CHUNK_SIZE=500
CHUNK_OVERLAP=80
RECALL_K=30
RERANK_K=20
CONTEXT_K=6
MIN_RERANK_SCORE=0.2
SESSION_TTL=86400
RAG_VOLUME_DIR=./volumes
